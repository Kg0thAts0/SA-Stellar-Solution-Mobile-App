@host = http://localhost:5048


### ============================================================
### 1. DATABASE TEST
### ============================================================

GET {{host}}/api/database-test
Accept: application/json


### ============================================================
### 2. ADMIN LOGIN
### ============================================================

POST {{host}}/api/auth/login
Content-Type: application/json

{
  "email": "admin@qafactory.com",
  "password": "Admin@123"
}


### ============================================================
### 3. ADMIN DASHBOARD - NO TOKEN
### Expected: 401 Unauthorized
### ============================================================

GET {{host}}/api/admin/dashboard
Accept: application/json


### ============================================================
### 4. ADMIN DASHBOARD - WITH TOKEN
### Replace YOUR_ADMIN_TOKEN with the token returned by login
### ============================================================

GET {{host}}/api/admin/dashboard
Accept: application/json
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..BsRxeQkXQzCKCYSfFBPWRjNyp-ouhXTnruZjyLgLGDg
 